---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleContent from '../../components/ArticleContent.astro';
import {visibleArticles,formatDate,withdrawnArticles,withdrawalReason} from '../../lib/catalogue';
export function getStaticPaths(){return [...visibleArticles().map(a=>({params:{slug:a.slug},props:{article:a,withdrawn:false}})),...withdrawnArticles().map(a=>({params:{slug:a.slug},props:{article:a,withdrawn:true}}))];}
const {article:a,withdrawn}=Astro.props;
const related=visibleArticles().filter(x=>a.relatedIds.includes(x.id));
---
<Layout title={a.title} description={a.description} article={withdrawn?undefined:a}>
{withdrawn?<section class="reading wrap"><p class="eyebrow">Article withdrawn for correction</p><h1>{a.title}</h1><p>{withdrawalReason(a.id)}</p><p>Original publication: {formatDate(a.publishedAt)}</p><a href="/library/">Browse the library →</a></section>:<>
<ArticleContent article={a}/>
{related.length>0&&<section class="wrap section-space"><h2>Another useful place to start</h2><div class="card-grid">{related.map(article=><ArticleCard article={article}/>)}</div></section>}
</>}
</Layout>
