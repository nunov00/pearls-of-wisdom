---
import Layout from '../../layouts/Layout.astro';import ArticleCard from '../../components/ArticleCard.astro';import {visibleArticles,formatDate,categorySlug,withdrawnArticles,withdrawalReason} from '../../lib/catalogue';
export function getStaticPaths(){return [...visibleArticles().map(a=>({params:{slug:a.slug},props:{article:a,withdrawn:false}})),...withdrawnArticles().map(a=>({params:{slug:a.slug},props:{article:a,withdrawn:true}}))];}
const {article:a,withdrawn}=Astro.props;const related=visibleArticles().filter(x=>a.relatedIds.includes(x.id));
---
<Layout title={a.title} description={a.description} article={withdrawn?undefined:a}>{withdrawn?<section class="reading wrap"><p class="eyebrow">Article withdrawn for correction</p><h1>{a.title}</h1><p>{withdrawalReason(a.id)}</p><p>Original publication: {formatDate(a.publishedAt)}</p><a href="/library/">Browse the library →</a></section>:<><article class="reading wrap"><header class="article-header"><a class="eyebrow" href={`/categories/${categorySlug(a.category)}/`}>{a.category}</a><h1>{a.title}</h1><p class="article-intro">{a.introduction}</p><p class="article-meta">{a.publishedAt?<time datetime={a.publishedAt}>Published {formatDate(a.publishedAt)}</time>:<span>Unpublished editorial draft</span>}{a.revisedAt&&<span> · Revised <time datetime={a.revisedAt}>{formatDate(a.revisedAt)}</time></span>}</p><p class="scope"><strong>Who this is for</strong> {a.audience}</p></header>
<nav class="on-this-page" aria-label="Recommendations"><span class="eyebrow">Your {a.recommendations.length} foundations</span><ol>{a.recommendations.map(r=><li><a href={`#${r.id}`}>{r.heading}</a></li>)}</ol></nav>
{a.figure&&<figure class="article-figure"><img src={a.figure.src} alt={a.figure.alt} loading="lazy"/><figcaption>{a.figure.caption}</figcaption><details><summary>Figure explanation</summary><p>{a.figure.description}</p></details></figure>}<div class="recommendations">{a.recommendations.map((r,i)=><section class="recommendation" id={r.id}><div class="recommendation-title"><span class="number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h2>{r.heading}</h2></div><p class="what">{r.whatToDo}</p><div class="explanation"><h3>Why it matters</h3><p>{r.whyItMatters}</p><h3>If you leave it out</h3><p>{r.consequence}</p></div>{r.safety&&<p class="safety-note">{r.safety}</p>}<div class="action"><span class="eyebrow">One small step</span><p>{r.action}</p></div><details><summary>Evidence &amp; a little more detail</summary><div class="expanded"><p>{r.details}</p>{a.claims.filter(c=>r.claimIds.includes(c.id)).map(c=><div class="claim"><span class="evidence-tag">{c.strength.replaceAll('-',' ')} · {c.basis}</span><p>{c.text}</p><p class="fine-print">{c.strengthRationale}</p><ul>{c.sourceIds.map(id=>{const s=a.sources.find(s=>s.id===id)!;return <li><a href={s.url} rel="noreferrer">{s.organisation}: {s.title} ↗</a></li>;})}</ul></div>)}</div></details></section>)}</div>
<aside class="limitations"><p class="eyebrow">The evidence has edges</p><h2>What to keep in mind</h2><p>{a.limitations}</p><p class="fine-print">Evidence last checked {formatDate(a.lastEvidenceCheckedAt)}. {a.selection.basis==='foundations'?'These are important foundations, not a scientifically measured ranking.':'The order reflects the evidence and audience described here.'}</p></aside>
<details class="source-list"><summary>Sources &amp; verification notes ({a.sources.length})</summary><ol>{a.sources.map(s=><li><a href={s.url} rel="noreferrer">{s.title} ↗</a><p>{s.organisation} · {s.access==='checked'?'Page checked':s.access==='partial'?'Partially accessible':'Not accessible'} · {formatDate(s.checkedAt)}</p><p>{s.support}</p><p class="fine-print">Checked section: {s.section}. Limits: {s.limitations}</p></li>)}</ol></details>
<div class="summary-card"><p class="eyebrow">Keep the essentials</p><h2>{a.summary.title}</h2><ol>{a.summary.recommendationIds.map(id=><li>{a.recommendations.find(r=>r.id===id)!.heading}</li>)}</ol><p class="fine-print">{a.audience}</p></div>
<div class="share-row"><button id="share" class="button" type="button">Share this article ↗</button><span id="share-status" role="status"></span><a href="/library/">Back to the library →</a></div></article>{related.length>0&&<section class="wrap section-space"><h2>Another useful place to start</h2><div class="card-grid">{related.map(article=><ArticleCard article={article}/>)}</div></section>}</>}</Layout>
<script>
document.querySelector('#share')?.addEventListener('click',async()=>{const status=document.querySelector('#share-status')!;try{if(navigator.share)await navigator.share({title:document.title,url:location.href});else if(navigator.clipboard){await navigator.clipboard.writeText(location.href);status.textContent='Link copied';}else status.textContent='Copy the address from your browser to share this article.';}catch(e){if((e as Error).name!=='AbortError')status.textContent='Copy the address from your browser to share this article.';}});
</script>
