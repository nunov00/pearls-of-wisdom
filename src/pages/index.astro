---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {visibleArticles,formatDate} from '../lib/catalogue';
const articles=visibleArticles();const latest=articles[0];
---
<Layout><section class="hero wrap"><p class="eyebrow">A practical guide to what matters</p><h1>A little clarity.<br/><em>A useful next step.</em></h1><p class="hero-intro">Three important things you can do. The evidence behind them. One small place to start.</p></section>
{latest?<><section class="wrap featured" aria-labelledby="featured-title"><div class="featured-top"><span class="eyebrow">{latest.publishedAt?'Latest article':'Inside the first issue'}</span><span>{formatDate(latest.publishedAt)}</span></div><div class="feature-grid"><div><p class="eyebrow">{latest.category}</p><h2 id="featured-title"><a href={`/articles/${latest.slug}/`}>{latest.title}</a></h2><p>{latest.description}</p><a class="button" href={`/articles/${latest.slug}/`}>Find your next step <span aria-hidden="true">↗</span></a></div><ol class="feature-list">{latest.recommendations.map((r,i)=><li><span>{String(i+1).padStart(2,'0')}</span><a href={`/articles/${latest.slug}/#${r.id}`}>{r.heading}</a></li>)}</ol></div></section><section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">A few more places to begin</p><h2>Good ideas for everyday life</h2></div><a class="text-link" href="/library/">Explore the library →</a></div><div class="card-grid">{articles.slice(1).map(a=><ArticleCard article={a}/>)}</div></section></>:<section class="wrap empty-state"><h2>The first issue is on its way</h2><p>Articles appear here once their evidence and recommendations have passed review.</p></section>}
<section class="manifesto wrap"><p class="eyebrow">Less noise. More substance.</p><h2>Useful enough to act on.<br/>Clear enough to remember.</h2><p>We look for the foundations that deserve your attention, explain the trade-offs, and show you the sources.</p><a class="text-link" href="/about/">How we choose what matters →</a></section></Layout>
