---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleContent from '../components/ArticleContent.astro';
import {visibleArticles} from '../lib/catalogue';
const articles=visibleArticles();const latest=articles[0];
---
<Layout title={latest?.title} description={latest?.description}>
{latest?<>
<ArticleContent article={latest}/>
<section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">A few more places to begin</p><h2>Good ideas for everyday life</h2></div><a class="text-link" href="/library/">Explore the library →</a></div><div class="card-grid">{articles.slice(1).map(a=><ArticleCard article={a}/>)}</div></section>
</>:<section class="wrap empty-state"><h1>The first issue is on its way</h1><p>Articles appear here once their evidence and recommendations have passed review.</p></section>}
</Layout>
