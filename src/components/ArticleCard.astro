---
import type { Article } from '../lib/schema';
import { categorySlug,formatDate } from '../lib/catalogue';
const {article:a}=Astro.props as {article:Article};
---
<article class:list={['article-card',{'has-thumb':!!a.mainImage}]} data-search-item data-title={a.title.toLowerCase()} data-category={a.category}>
 <p class="card-meta"><time datetime={a.publishedAt ?? undefined}>{formatDate(a.publishedAt)}</time> · <a href={`/categories/${categorySlug(a.category)}/`}>{a.category}</a></p>
 <div class="card-body">
  {a.mainImage&&<img class="card-thumb" src={a.mainImage.src} alt="" width="1200" height="630" loading="lazy" decoding="async"/>}
  <h3><a href={`/articles/${a.slug}/`}>{a.title}</a></h3>
 </div>
</article>
